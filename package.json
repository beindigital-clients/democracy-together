{
  "name": "democracy-together",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "tsc -p convex --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:login": "node -e \"require('fs').rmSync('tests/e2e/.auth',{recursive:true,force:true})\" && playwright test --project=setup",
    "test:e2e:ui": "playwright test --ui",
    "test:dev-browser": "node -e \"require('fs').rmSync('screenshots',{recursive:true,force:true})\" && playwright test --project=dev-browser",
    "convex": "convex dev",
    "sanity": "sanity dev",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@sanity/client": "^7.23.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.0",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.42.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.21.0",
    "next": "16.3.5",
    "next-intl": "^4.13.0",
    "next-sanity": "^13.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanity": "^6.15.0",
    "tailwind-merge": "^3.6.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.0.3",
    "convex-test": "^0.0.59",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "^5.0.9",
      "js-yaml@3": "^3.15.2",
      "undici@7": "^7.29.0",
      "nanoid@3": "^3.3.19",
      "browserslist@4": "^4.28.7",
      "smol-toml@1": "^1.7.1",
      "adm-zip@0": "^0.6.1",
      "dompurify@3": "^3.4.13",
      "baseline-browser-mapping@2": "^2.11.0",
      "valibot@1": "^1.4.2",
      "postcss@8": "^8.5.23",
      "@sanity/uuid@3": "^3.0.3"
    }
  }
}
