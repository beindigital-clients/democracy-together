# dependencies
node_modules
.pnpm-store

# tooling indexes (local only — contain sockets; must be excluded from Tailwind scan)
.codegraph/
.gstack/

# next.js
.next
out
build

# production / misc
*.tsbuildinfo
next-env.d.ts
.DS_Store
.vercel

# env
.env
.env*.local

# convex: `convex/_generated` is COMMITTED on purpose — no rule here.
# CI typechecks, tests and builds without a Convex deployment, so it cannot
# run `convex codegen` first: without these tracked files, all three jobs
# would fail on missing imports. This block never excluded anything (no
# pattern, only comments); it used to claim the opposite of what the repo does.

# commercial documents (quotes, amounts): they do not belong in a code
# repository, they are shared through the client channel. See issue #19.
/docs/devis-*.pdf

# tests
/test-results
/playwright-report
/playwright/.cache
/coverage
/screenshots

# Pre-opened E2E sessions (produced by the Playwright `setup` project)
tests/e2e/.auth/

# Safeguard (issue #44): any Playwright authentication state written OUTSIDE
# `tests/e2e/.auth/` stays out of the repo. An authentication `storageState`
# holds the session cookies — enough to impersonate the account.
# The cookie-consent file (`tests/e2e/cookie-consent-state.json`) does not
# match this pattern: it is committed on purpose.
*auth-state*.json

# Next server log captured during E2E runs (diagnostic #66)
server.log

# Regenerable audit artifacts (logs, traces) — the specs and PoCs themselves
# are committed: they regenerate everything.
audit/logs/
audit/traces/
audit/routes-statiques.txt
