# --- Convex (run `npx convex dev` once; it provisions and fills these) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- reCAPTCHA v3 (anti-spam for public forms: contact, newsletter,
#     membership). Keys at https://www.google.com/recaptcha/admin (type v3). ---
# SITE key (public, read by the browser). Without it, no widget is loaded and
# the forms work normally (no-op).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# SECRET key -> Convex DEPLOYMENT env, never here / never client-side:
#   npx convex env set RECAPTCHA_SECRET_KEY 6Lxxxxxxxxxxxxxxxx
# Without a key, public forms are REJECTED (fail-closed, issue #24): a key
# forgotten in production is a visible outage, not a missing protection.
# To develop without a Google account, request the bypass EXPLICITLY on the
# dev deployment — never in production:
#   npx convex env set RECAPTCHA_DISABLED true

# --- Content translation (Convex DEPLOYMENT env) ---
# Publications, Tribune posts and the languages editors leave empty in news
# articles are translated ONCE, when they go live, into every other site
# language (convex/translationJobs.ts); attached PDF documents are prepared
# by convex/documents.ts. It shares the gateway key with editorial moderation:
#   npx convex env set AI_GATEWAY_API_KEY vck_xxx
# Optional — without it, the repository's default model is used
# (anthropic/claude-sonnet-5.5):
#   npx convex env set TRANSLATION_MODEL anthropic/claude-sonnet-5.5
# Optional — model calls allowed per 24 hours for these translations (300 by
# default); over it, jobs wait for the next window instead of failing:
#   npx convex env set TRANSLATION_DAILY_CAP 300
# Attached PDFs are translated too, keeping their layout
# (convex/documentJobs.ts); optional cap, in documents per 24 hours (60):
#   npx convex env set DOCUMENT_TRANSLATION_DAILY_CAP 60
# Without a gateway KEY, no translation is possible: content is shown in its
# original language and the page says so. Nothing degrades silently.

# --- Convex DEPLOYMENT env (set via `npx convex env set ...`, NOT here) ---
# Auth (Convex Auth):
#   JWT_PRIVATE_KEY, JWKS, SITE_URL=http://localhost:3000
# Transactional e-mail (verification / reset / sign-in OTP) — pick a provider:
#   AUTH_RESEND_KEY=re_xxx                 # Resend (otherwise, codes logged in dev)
#   AUTH_EMAIL_FROM="Democracy Together <no-reply@democracytogether.org>"
#   AUTH_EMAIL_PROVIDER=resend             # future: ses | scaleway | brevo
# Initial administrator bootstrap (only for the procedure, then remove):
#   BOOTSTRAP_ADMIN_EMAIL=admin@exemple.org
#   -> npx convex run bootstrap:bootstrapAdmin '{"email":"admin@exemple.org"}' --prod
#   Inert as soon as an admin exists. Procedure: docs/deploiement.md
# AI-assisted editorial moderation (OPTIONAL — see docs/moderation-ia.md):
#   AI_GATEWAY_API_KEY=vck_xxx           # Vercel AI Gateway
#   -> npx convex env set AI_GATEWAY_API_KEY vck_xxx
# Without this key, NO submission is analysed and the moderation queue stays
# fully human: that is the fallback behaviour, not an outage. The key alone
# does not arm the feature either — the mode is set in /admin/moderation-ia
# and stays "disabled" until an administrator changes it.
# Tests:
#   AUTH_DEV_OTP=true                      # exposes OTP codes IN CLEAR — NEVER
#                                          # in prod: opens the WHOLE dev
#                                          # surface (see docs/deploiement.md § 1.1)
#   RECAPTCHA_DISABLED=true                # bypasses reCAPTCHA in dev — NEVER in prod

# --- Infisical (MCP server declared in .mcp.json; variables read from the
#     environment that launches Claude Code, NOT from this file) ---
#   INFISICAL_HOST_URL=https://app.infisical.com
#   INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=...
#   INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=...
