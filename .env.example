# --- Convex (run `npx convex dev` once; it provisions and fills these) ---
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Sanity (create a project at sanity.io/manage, EU dataset region) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
SANITY_API_READ_TOKEN=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- reCAPTCHA v3 (anti-spam des formulaires publics : contact, newsletter,
#     adhésion). Clés sur https://www.google.com/recaptcha/admin (type v3). ---
# Clé de SITE (publique, lue par le navigateur). Sans elle, aucun widget n'est
# chargé et les formulaires fonctionnent normalement (no-op).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Clé SECRÈTE -> env de DÉPLOIEMENT Convex, jamais ici / jamais côté client :
#   npx convex env set RECAPTCHA_SECRET_KEY 6Lxxxxxxxxxxxxxxxx
# Sans clé, les formulaires publics sont REJETÉS (fail-closed, issue #24) : une
# clé oubliée en production est une panne visible, pas une protection absente.
# Pour développer sans compte Google, demandez le contournement EXPLICITEMENT
# sur le déploiement de dev — jamais en production :
#   npx convex env set RECAPTCHA_DISABLED true

# --- Convex DEPLOYMENT env (set via `npx convex env set ...`, PAS ici) ---
# Auth (Convex Auth) :
#   JWT_PRIVATE_KEY, JWKS, SITE_URL=http://localhost:3000
# E-mail transactionnel (OTP vérif / reset / connexion) — choisir un fournisseur :
#   AUTH_RESEND_KEY=re_xxx                 # Resend (sinon, codes loggés en dev)
#   AUTH_EMAIL_FROM="Democracy Together <no-reply@democracytogether.org>"
#   AUTH_EMAIL_PROVIDER=resend             # futur : ses | scaleway | brevo
# Amorçage de l'administrateur initial (le temps de la procédure, puis retirer) :
#   BOOTSTRAP_ADMIN_EMAIL=admin@exemple.org
#   -> npx convex run bootstrap:bootstrapAdmin '{"email":"admin@exemple.org"}' --prod
#   Inopérante dès qu'un admin existe. Procédure : docs/deploiement.md
# Modération éditoriale assistée par IA (FACULTATIVE — cf. docs/moderation-ia.md) :
#   AI_GATEWAY_API_KEY=vck_xxx           # passerelle Vercel AI Gateway
#   -> npx convex env set AI_GATEWAY_API_KEY vck_xxx
# Sans cette clé, AUCUN dépôt n'est analysé et la file de modération reste
# entièrement humaine : c'est le comportement de repli, pas une panne. La clé
# ne suffit d'ailleurs pas à armer le dispositif — le mode se règle dans
# /admin/moderation-ia et vaut « désactivé » tant qu'un administrateur ne l'a
# pas changé.
# Tests :
#   AUTH_DEV_OTP=true                      # expose les codes OTP EN CLAIR — JAMAIS
#                                          # en prod : ouvre TOUTE la surface de
#                                          # dev (cf. docs/deploiement.md § 1.1)
#   RECAPTCHA_DISABLED=true                # contourne reCAPTCHA en dev — JAMAIS en prod
